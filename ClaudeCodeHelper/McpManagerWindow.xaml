<Window x:Class="ClaudeCodeHelper.McpManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClaudeCodeHelper"
        mc:Ignorable="d"
        Title="로컬MCP 관리" Height="560" Width="760" MinHeight="460" MinWidth="620">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.5*"/>
        </Grid.RowDefinitions>

        <!-- Row0: 프로젝트(다중) | 프리셋(단일) + 프리셋 저장/삭제 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="프로젝트 (Ctrl/Shift 다중선택)" Margin="0,0,0,4"/>
                <ListBox x:Name="lstProjects" SelectionMode="Extended"
                         SelectionChanged="LstProjects_SelectionChanged"/>
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="프리셋 (선택 시 명령에 채워짐)" Margin="0,0,0,4"/>
                <ListBox x:Name="lstPresets" SelectionMode="Single" DisplayMemberPath="Name"
                         SelectionChanged="LstPresets_SelectionChanged"/>
            </DockPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Top" Width="110">
                <TextBlock Text="프리셋 이름" Margin="0,0,0,4"/>
                <TextBox x:Name="txtPresetName" Height="26" Margin="0,0,0,6"/>
                <Button x:Name="btnSavePreset"   Content="프리셋으로 저장" Click="BtnSavePreset_Click"   Margin="0,0,0,6" Height="28"/>
                <Button x:Name="btnDeletePreset" Content="프리셋 삭제"     Click="BtnDeletePreset_Click" Height="28"/>
            </StackPanel>
        </Grid>

        <!-- Row1: 명령 라벨 -->
        <TextBlock Grid.Row="1" Text="실행할 명령 (claude mcp add ... 통째로 입력 / 프리셋 선택)" Margin="0,12,0,4"/>

        <!-- Row2: 명령 입력(단일 라인 + 가로 스크롤) + 실행 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="txtCommand" Height="28" VerticalContentAlignment="Center"
                     AcceptsReturn="False" TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                     FontFamily="Consolas" Margin="0,0,8,0"/>
            <Button Grid.Column="1" x:Name="btnRun" Content="선택 프로젝트에서 실행"
                    Click="BtnRun_Click" Padding="10,0" Height="30"/>
        </Grid>

        <!-- Row3: 설치된 MCP 라벨 + 새로고침 + 제거 -->
        <Grid Grid.Row="3" Margin="0,12,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="설치된 MCP (선택 프로젝트 기준, local만 추적)" VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="btnRefreshInstalled" Content="새로고침" Click="BtnRefreshInstalled_Click" Padding="8,0" Height="24" Margin="0,0,8,0"/>
            <Button Grid.Column="2" x:Name="btnRemove" Content="선택 항목 제거" Click="BtnRemove_Click" Padding="8,0" Height="24"/>
        </Grid>

        <!-- Row4: 설치된 MCP 목록 -->
        <ListBox Grid.Row="4" x:Name="lstInstalled" SelectionMode="Extended">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding Name}"/>
                        <Run Text=" ("/><Run Text="{Binding Scope}"/><Run Text=")"/>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Row5: 로그 라벨 -->
        <TextBlock Grid.Row="5" Text="실행 로그" Margin="0,12,0,4"/>

        <!-- Row6: 로그 -->
        <TextBox Grid.Row="6" x:Name="txtLog" IsReadOnly="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"/>
    </Grid>
</Window>
