<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Release publish 설정: .NET 8의 `dotnet publish`는 기본 Release이므로
       옵션 없이 `dotnet publish`만으로 런타임 포함 단일 exe가 생성된다.
       Debug 빌드는 이 조건에 걸리지 않아 가볍게 유지된다. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WPF 네이티브 DLL(wpfgfx 등)도 exe에 임베드 → exe 파일 하나만 옮겨도 실행됨
         (실행 시 임시 폴더에 자동 추출) -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Release/배포에서 .pdb 미생성 (publish 폴더 깔끔하게) -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

</Project>
